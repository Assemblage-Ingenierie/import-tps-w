# Copier en .env.local pour un test en local (npm run dev), et déclarer les mêmes
# variables dans Vercel → Settings → Environment Variables.
# Aucune de ces valeurs ne doit être commitée : le dépôt est public.

# Identifiant client OAuth Google (Application Web). Déclarer chaque origine
# (production, URL de preview, http://localhost:3000) dans les « Origines
# JavaScript autorisées ». Non secret : exposé au navigateur par conception.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Domaine Google Workspace exigé. Tout compte de ce domaine peut se connecter (rôle User).
ALLOWED_HD=assemblage.net

# Administrateurs (validation mensuelle, balances, coûts, outil d'import historique).
ADMIN_EMAILS=prenom.nom@assemblage.net,autre.personne@assemblage.net

# Ancienne liste blanche : n'est plus qu'un repli pour ADMIN_EMAILS.
# ALLOWED_EMAILS=

# Secret de signature du cookie de session. Générer une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-longue

# Personal Access Token Airtable (data.records:read + data.records:write sur la base).
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Calendrier d'absences Payfit. SECRET PORTEUR : quiconque possède l'URL lit les
# absences de toute l'entreprise.
PAYFIT_ICS_URL=https://api.payfit.com/absences/calendar/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# « production » : écriture dans la table Temps W. Toute autre valeur (ou absence) :
# écriture dans Temps W TEST. À ne passer en production qu'à la bascule (un 1er du mois).
TPSW_ENV=
