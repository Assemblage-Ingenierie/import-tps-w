# Copier en .env.local pour un test en local (vercel dev), et déclarer les mêmes
# variables dans Vercel → Settings → Environment Variables pour la production.
# Aucune de ces valeurs ne doit être commitée : le dépôt est public.

# URL du calendrier d'absences Payfit.
# ATTENTION : cette URL est un secret porteur. Elle répond sans authentification,
# quiconque la possède lit le calendrier d'absences de toute l'entreprise.
PAYFIT_ICS_URL=https://api.payfit.com/absences/calendar/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Identifiant client OAuth Google (console.cloud.google.com → API et services →
# Identifiants → ID client OAuth → Application Web).
# Origines JavaScript autorisées : https://<votre-domaine>
# Cette valeur n'est pas secrète, elle est exposée au navigateur par conception.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Liste des adresses autorisées, séparées par des virgules.
# Seules ces adresses accèdent à l'application, bilan et coûts compris.
ALLOWED_EMAILS=prenom.nom@assemblage.net,autre.personne@assemblage.net

# Domaine Google Workspace exigé en plus de la liste ci-dessus (défense en
# profondeur : un compte personnel portant la même adresse serait refusé).
ALLOWED_HD=assemblage.net

# Secret de signature du cookie de session. Générer une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-longue

# Personal Access Token Airtable, partagé par tous les utilisateurs autorisés
# de l'application — plus besoin que chacun crée le sien. Scopes requis :
# data.records:read + data.records:write sur la base Assemblage.
# Secret : quiconque le détient lit et modifie la base Airtable en entier.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
